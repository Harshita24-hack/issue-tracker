generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Severity {
  low
  medium
  high
  critical
}

enum Status {
  open
  in_progress
  resolved
  closed
}

/// Application roles for RBAC.
/// - user: default; report bugs, comment, vote
/// - admin: triage bugs (status / severity / assignee)
/// - super_admin: all admin powers + manage user roles
enum Role {
  user
  admin
  super_admin
}

enum BugPlatform {
  web
  mobile
  desktop
  api_backend
}

enum ActivityType {
  created
  status_changed
  severity_changed
  assignee_changed
  commented
  edited
  boosted
  unboosted
  deleted
  restored
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  /// Null for Google-only accounts; required for credentials login/signup.
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          Role          @default(user)
  createdAt     DateTime      @default(now())
  reportedBugs  Bug[]         @relation("BugReporter")
  assignedBugs  Bug[]         @relation("BugAssignee")
  comments            Comment[]
  votes               Vote[]
  activities          BugActivity[]
  passwordResetTokens PasswordResetToken[]
  savedBugs           SavedBug[]
}

/// Single-use password reset tokens (~30 min TTL). Store only the SHA-256 hash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IssueType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bugs        Bug[]
}

model Bug {
  id          String        @id @default(cuid())
  title       String
  description String
  severity    Severity      @default(medium)
  status      Status        @default(open)
  typeId      String?
  type        IssueType?    @relation(fields: [typeId], references: [id], onDelete: SetNull)
  platform    BugPlatform?
  voteCount   Int           @default(0)
  isBoosted   Boolean       @default(false)
  boostedAt   DateTime?
  isDeleted   Boolean       @default(false)
  deletedAt   DateTime?
  proofLinks  String[]      @default([])
  reporterId  String
  assigneeId  String?
  categoryId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  reporter    User          @relation("BugReporter", fields: [reporterId], references: [id])
  assignee    User?         @relation("BugAssignee", fields: [assigneeId], references: [id])
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  comments    Comment[]
  votes       Vote[]
  activities  BugActivity[]
  savedBy     SavedBug[]

  @@index([categoryId])
  @@index([typeId])
  @@index([platform])
  @@index([isBoosted])
  @@index([isDeleted])
}

model SavedBug {
  userId    String
  bugId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@id([userId, bugId])
  @@index([bugId])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bugs      Bug[]
}

model BugActivity {
  id        String       @id @default(cuid())
  bugId     String
  actorId   String
  type      ActivityType
  summary   String
  metadata  Json?
  createdAt DateTime     @default(now())
  bug       Bug          @relation(fields: [bugId], references: [id], onDelete: Cascade)
  actor     User         @relation(fields: [actorId], references: [id])

  @@index([bugId, createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  bugId     String
  authorId  String
  parentId  String?
  body      String
  createdAt DateTime  @default(now())
  bug       Bug       @relation(fields: [bugId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([bugId])
  @@index([parentId])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  bugId     String
  value     Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@unique([userId, bugId])
  @@index([bugId])
}
